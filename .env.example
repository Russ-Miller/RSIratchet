# Copy to .env and fill in. .env is untracked.
# Milestone 4: GitHub OAuth app for local dev (callback http://localhost:3000/api/auth/callback/github)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_SECRET=
# Milestone 4: Neon Postgres
DATABASE_URL=
# Milestone 5: arXiv pipeline classification
ANTHROPIC_API_KEY=

# Admin sign-in for the working pages (see scripts/admin-password.mjs)
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
AUTH_SECRET=
# Evidence form on claim pages: a fine-grained GitHub token with Issues read/write on this repo.
# Set on Vercel (production). Without it the form opens a prefilled GitHub issue instead.
EVIDENCE_GITHUB_TOKEN=
