{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modelselfhelp.dev/schema/capability.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "ref",
    "label",
    "summary",
    "description",
    "status",
    "submitted_by"
  ],
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/slug"
    },
    "ref": {
      "type": "string",
      "pattern": "^CAP-\\d{4}$",
      "description": "Stable opaque identifier, assigned by scripts/assign-ids.mjs, never changed or reused. Cite this, not the slug."
    },
    "label": {
      "type": "string",
      "minLength": 3,
      "maxLength": 60
    },
    "summary": {
      "type": "string",
      "minLength": 20,
      "maxLength": 240
    },
    "description": {
      "type": "string",
      "minLength": 40
    },
    "tags": {
      "type": "array",
      "$ref": "common.schema.json#/$defs/slugList"
    },
    "group": {
      "$ref": "common.schema.json#/$defs/slug",
      "description": "Primary home in taxonomy.yaml groups, for the map. Tags stay soft and may name other groups."
    },
    "modality": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "text",
          "image",
          "audio",
          "video",
          "action"
        ]
      }
    },
    "parent": {
      "$ref": "common.schema.json#/$defs/slug"
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "match_terms": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "discriminator": {
      "type": "string",
      "minLength": 40
    },
    "techniques": {
      "type": "array",
      "$ref": "common.schema.json#/$defs/slugList"
    },
    "related": {
      "type": "array",
      "$ref": "common.schema.json#/$defs/slugList"
    },
    "status": {
      "type": "string",
      "enum": [
        "proposed",
        "active",
        "parked"
      ],
      "description": "proposed: mined from recurring framings in the literature and added without a human endorsing it. Browsable and challengeable, and marked as such. active: judged worth tracking. parked: noted, not being actively studied."
    },
    "submitted_by": {
      "$ref": "common.schema.json#/$defs/provenance"
    }
  }
}
