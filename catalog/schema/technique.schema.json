{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modelselfhelp.dev/schema/technique.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "ref",
    "label",
    "summary",
    "description",
    "addresses",
    "kind",
    "status",
    "submitted_by"
  ],
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/slug"
    },
    "ref": {
      "type": "string",
      "pattern": "^TEC-\\d{4}$",
      "description": "Stable opaque identifier, assigned by scripts/assign-ids.mjs, never changed or reused. Cite this, not the slug."
    },
    "label": {
      "type": "string",
      "minLength": 3,
      "maxLength": 60
    },
    "summary": {
      "type": "string",
      "minLength": 20,
      "maxLength": 240
    },
    "description": {
      "type": "string",
      "minLength": 40
    },
    "addresses": {
      "type": "array",
      "$ref": "common.schema.json#/$defs/slugList",
      "minItems": 1
    },
    "kind": {
      "type": "string",
      "enum": [
        "prompting",
        "retrieval",
        "tooling",
        "training",
        "decoding",
        "architecture",
        "process"
      ]
    },
    "sources": {
      "type": "array",
      "$ref": "common.schema.json#/$defs/slugList"
    },
    "repos": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "url",
          "note"
        ],
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "note": {
            "type": "string",
            "minLength": 5
          },
          "verified_on": {
            "$ref": "common.schema.json#/$defs/date"
          }
        }
      }
    },
    "contexts": {
      "type": "array",
      "$ref": "common.schema.json#/$defs/slugList"
    },
    "requires": {
      "type": "string"
    },
    "evidence_search": {
      "type": "object",
      "additionalProperties": false,
      "description": "A record of having looked for efficacy evidence and not found it. Turns an empty cell into a negative result with provenance. Absent means nobody has looked, which is a different state from having looked and come up empty.",
      "required": [
        "searched_on",
        "note"
      ],
      "properties": {
        "searched_on": {
          "$ref": "common.schema.json#/$defs/date"
        },
        "note": {
          "type": "string",
          "minLength": 40,
          "description": "What was searched for, and what the state of the literature appeared to be."
        },
        "nearest_miss": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "why_it_does_not_fit"
            ],
            "properties": {
              "source": {
                "$ref": "common.schema.json#/$defs/slug"
              },
              "title": {
                "type": "string"
              },
              "url": {
                "type": "string",
                "format": "uri"
              },
              "why_it_does_not_fit": {
                "type": "string",
                "minLength": 30
              }
            }
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "proposed",
        "active",
        "superseded"
      ]
    },
    "submitted_by": {
      "$ref": "common.schema.json#/$defs/provenance"
    }
  }
}
